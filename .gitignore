node_modules/
.env
.env.*
!.env.example
data/*.db
data/research/
# Machine-learned state: environment-specific, regenerated, and discardable.
data/tuning.json
docs/self-improvement.md
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/HALT
*.log
scratch/
devnet.json
config.json
!src/config/default.config.json
wallet*.json
keypair*.json
*keypair*.json
data/*keypair*.json
.DS_Store
# Exported corpus: a point-in-time snapshot of the DB, 3MB+ and regenerable
# with scripts/export-corpus.ts -- history for the hard drive, not for git.
data/export/
data/*.bak*
# `data/*.bak*` does NOT cover `bot.db.backup-<timestamp>`, which is the name
# the DB backups actually use -- verified with `git check-ignore`. A 72MB
# database holding the full launch history was sitting untracked, one
# `git add -A` away from being committed.
data/*.backup-*
data/*.backup
# Lore corpus: 6MB rebuilt from NASA/JPL in one call by
# scripts/fetch-lore-corpus.ts. Regenerable per host, and deploy.sh excludes
# data/ anyway -- so it is fetched on each machine, never shipped through git.
data/lore/
