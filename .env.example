# Copy to .env and fill in. .env is gitignored -- never commit real values.

# ---------------------------------------------------------------- REQUIRED (live)
# Dev wallet secret: base58 (Phantom export) or a JSON byte array (solana-keygen).
# Use a FRESH wallet funded only with capital you would write off entirely.
# Not needed for `npm run dry-run`, which uses an ephemeral throwaway key.
DEV_WALLET_SECRET=

# A dedicated RPC. The free public endpoint will rate-limit you out of
# contention on exactly the launches worth winning.
# Set via config.json rpc.primary, or export here and reference it there.
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=...

# Pinata JWT. pump.fun's own /api/ipfs endpoint is deprecated, so token
# metadata has to be pinned externally. Free tier is sufficient.
PINATA_JWT=

# ------------------------------------------------------------- STRONGLY ADVISED
# Without this, trademark and likeness screening falls back to the static
# blocklist plus a crude capitalisation heuristic. During testing the static
# list alone let "usa network" and "kevin keegan" through. The model screen
# rides along on the naming call, so it costs nothing extra.
ANTHROPIC_API_KEY=

# --------------------------------------------------------------- ADMIN PORTAL
# Generate with:  npm run admin-password
# Without this the admin portal is DISABLED (returns 503) -- it never falls
# open, and there is no default credential. The password itself is never
# stored; only this scrypt hash.
ADMIN_PASSWORD_HASH=

# ANTHROPIC_API_KEY above also powers self-tuning (learning.enabled), which
# reads launch outcomes and proposes adjustments to how picky the bot is.
# It can never adjust spend limits -- see src/learning/guardrails.ts.

# ---------------------------------------------------------------- OPTIONAL FEEDS
# NOTE: hackernews, googleNews and wikipedia need NO key and are on by default.
# The keys below only widen coverage further.
# Reddit: create a "script" app at https://www.reddit.com/prefs/apps
# The unauthenticated .json endpoints now return 403, so this is required
# even though the data is public. Free tier ~100 req/min.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Farcaster trending casts via Neynar. Free tier is adequate.
NEYNAR_API_KEY=

# X / Twitter. Pay-per-use since Feb 2026 (~$0.005 per post read, no free
# tier). Disabled in the default config. If you enable it, keep
# feeds.xApi.monthlyUsdCap honest -- the meter is charged before each request
# so a polling bug wastes a poll rather than running up a bill.
X_BEARER_TOKEN=
